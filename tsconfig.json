{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // "baseUrl" foi removido de propósito (01/10): com "moduleResolution":
    // "bundler", o "paths" abaixo já resolve o alias "@/" sozinho, sem
    // precisar de "baseUrl" — e "baseUrl" é uma opção preterida que virou
    // ERRO FATAL de configuração em algumas instalações do TypeScript
    // (variou de máquina pra máquina nos testes, por isso a solução foi
    // tirar a opção problemática em vez de tentar acertar o valor exato
    // de "ignoreDeprecations"). "npm run build" parava antes de checar um
    // arquivo sequer por causa disso.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}